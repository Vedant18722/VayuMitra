# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAQ_API_KEY: Optional API key for OpenAQ v3 ground monitoring stations.
# When omitted, VAYUMITRA uses Open-Meteo (CAMS atmospheric model forecasts).
OPENAQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Web Push (VAPID) credentials for background push notifications.
# Keep VAPID_PRIVATE_KEY strictly server-side (never prefix with VITE_).
# Leave empty if background push delivery is not configured.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

